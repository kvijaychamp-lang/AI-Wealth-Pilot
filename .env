# =============================================================================
# STOCK MARKET AI CONFIGURATION - SECURE ENVIRONMENT VARIABLES
# =============================================================================
# IMPORTANT SECURITY NOTES:
# 1. Never commit .env files to version control
# 2. Use strong, unique API keys for each service
# 3. Rotate API keys regularly
# 4. Store sensitive keys in secure vaults when possible
# 5. Use environment-specific keys (dev/staging/prod)
# =============================================================================

# APPLICATION ENVIRONMENT
# Options: development, staging, production
APP_ENV=development

# =============================================================================
# API KEYS - STORE SECURELY
# =============================================================================
# NSE/BSE Data API Key (get from official NSE API portal)
NSE_API_KEY=your_real_nse_api_key_here
# Alternative data provider API key (if using external services)
DATA_API_KEY=your_data_api_key_here
# OpenAI API key for AI features (if used)
OPENAI_API_KEY=your_openai_api_key_here
# Database connection string (if using external DB)
DATABASE_URL=your_database_url_here

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Directory for trained models
MODEL_DIR=models
# Default model version to use
DEFAULT_MODEL_VERSION=v1.0
# Model file paths (relative to MODEL_DIR)
RANDOM_FOREST_MODEL=random_forest_classifier.pkl
LSTM_MODEL=lstm_predictor.pkl

# =============================================================================
# STOCK SYMBOLS CONFIGURATION
# =============================================================================
# Default stock symbols to track (comma-separated)
DEFAULT_STOCK_SYMBOLS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS
# Nifty 50 symbols (comma-separated list)
NIFTY_50_SYMBOLS=ADANIPORTS.NS,ADANIENT.NS,ADANIGREEN.NS,ADANIPOWER.NS,ADANITRANS.NS,AMBUJACEM.NS,APOLLOHOSP.NS,APOLLOTYRE.NS,ASHOKLEY.NS,ASIANPAINT.NS,AUROPHARMA.NS,DMART.NS,AXISBANK.NS,BAJAJ-AUTO.NS,BAJAJFINSV.NS,BAJAJHLDNG.NS,BANDHANBNK.NS,BANKBARODA.NS,BERGEPAINT.NS,BHARTIARTL.NS,BHEL.NS,BIOCON.NS,BOSCHLTD.NS,BPCL.NS,BRITANNIA.NS,CADILAHC.NS,CANBK.NS,CANFINHOME.NS,CENTURYTEX.NS,CHOLAFIN.NS,CIPLA.NS,COALINDIA.NS,COLPAL.NS,CONCOR.NS,CUMMINSIND.NS,DHANI.NS,DIVISLAB.NS,DLF.NS,DRREDDY.NS,EICHERMOT.NS,EQUITAS.NS,ESCORTS.NS,EXIDEIND.NS,GAIL.NS,GMRINFRA.NS,GODREJCP.NS,GODREJIND.NS,GODREJPROP.NS,GRASIM.NS,HAVELLS.NS,HCLTECH.NS,HDFC.NS,HDFCBANK.NS,HDFCLIFE.NS,HEROMOTOCO.NS,HINDALCO.NS,HINDPETRO.NS,HINDUNILVR.NS,HINDZINC.NS,ICICIBANK.NS,ICICIGI.NS,ICICIPRULI.NS,IDBI.NS,IDFCFIRSTB.NS,IEX.NS,IGL.NS,INDHOTEL.NS,INDIAMART.NS,INDIGO.NS,INDUSINDBK.NS,INDUSTOWER.NS,INFY.NS,IOC.NS,IPCALAB.NS,IRCTC.NS,ITC.NS,JINDALSTEL.NS,JSWSTEEL.NS,JUBLFOOD.NS,KOTAKBANK.NS,L&TFH.NS,LALPATHLAB.NS,LAURUSLABS.NS,LICHSGFIN.NS,LT.NS,LTI.NS,LTTS.NS,LUPIN.NS,M&M.NS,M&MFIN.NS,MANAPPURAM.NS,MARICO.NS,MARUTI.NS,MCDOWELL-N.NS,METROPOLIS.NS,MFSL.NS,MGL.NS,MINDTREE.NS,MOTHERSUMI.NS,MPHASIS.NS,MUTHOOTFIN.NS,NATIONALUM.NS,NAUKRI.NS,NAVINFLUOR.NS,NESTLEIND.NS,NMDC.NS,NTPC.NS,ONGC.NS,ORIENTELEC.NS,PAGEIND.NS,PETRONET.NS,PFC.NS,PFIZER.NS,PIIND.NS,PIRAMAL.NS,PNB.NS,POWERGRID.NS,PVR.NS,RAMCOCEM.NS,RBLBANK.NS,RECLTD.NS,RELIANCE.NS,SAIL.NS,SANOFI.NS,SBICARD.NS,SBIHFL.NS,SBI.NS,SHREECEM.NS,SIEMENS.NS,SRF.NS,SRTRANSFIN.NS,STAR.NS,SUNPHARMA.NS,SUNTV.NS,SYNGENE.NS,TATACHEM.NS,TATACONSUM.NS,TATAMOTORS.NS,TATAPOWER.NS,TATASTEEL.NS,TECHM.NS,TITAN.NS,TORNTPOWER.NS,TRENT.NS,TVSMOTOR.NS,UBL.NS,ULTRACEMCO.NS,UPL.NS,VEDL.NS,VOLTAS.NS,WELCORP.NS,WELSPUNIND.NS,WHIRLPOOL.NS,WIPRO.NS,ZEEL.NS,ZOMATO.NS,ZYDUSLIFE.NS
# Sector-specific symbols
BANKING_SYMBOLS=HDFCBANK.NS,ICICIBANK.NS,KOTAKBANK.NS,AXISBANK.NS,SBIN.NS
IT_SYMBOLS=TCS.NS,INFY.NS,WIPRO.NS,HCLTECH.NS,TECHM.NS

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Raw data directory
RAW_DATA_DIR=data/raw
# Processed data directory
PROCESSED_DATA_DIR=data/ml/processed
# Cache directory for API responses
CACHE_DIR=.cache

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Maximum log file size in MB
MAX_LOG_SIZE_MB=5
# Number of log backup files to keep
LOG_BACKUP_COUNT=5

# =============================================================================
# STREAMLIT DASHBOARD CONFIGURATION
# =============================================================================
# Port for Streamlit dashboard
STREAMLIT_PORT=8501
# Host for Streamlit (0.0.0.0 for all interfaces)
STREAMLIT_HOST=localhost
# Enable debug mode in development
STREAMLIT_DEBUG=true

# =============================================================================
# TRAINING CONFIGURATION
# =============================================================================
# Training data split ratio
TRAIN_TEST_SPLIT=0.8
# Random seed for reproducibility
RANDOM_SEED=42
# Batch size for training
BATCH_SIZE=32
# Number of epochs for training
EPOCHS=100

# =============================================================================
# LIVE DATA CONFIGURATION
# =============================================================================
# Update interval in seconds for live data
LIVE_UPDATE_INTERVAL=60
# Maximum retry attempts for API calls
MAX_API_RETRIES=3
# Timeout for API calls in seconds
API_TIMEOUT=30

# =============================================================================
# PREDICTION CONFIGURATION
# =============================================================================
# Confidence threshold for predictions
PREDICTION_THRESHOLD=0.6
# Maximum predictions per day
MAX_DAILY_PREDICTIONS=100
# Prediction cache TTL in seconds
PREDICTION_CACHE_TTL=300
